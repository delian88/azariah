DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization header to PHP environment
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Route API requests to PHP API router
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 2. Route index.html requests to index.php
  RewriteRule ^index\.html$ index.php [L]

  # 3. Route root assets to dist/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 4. Allow existing files and directories to be served directly (excluding index.html)
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Route all other requests to index.php (which serves dist/index.html)
  RewriteRule ^ index.php [L]
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
